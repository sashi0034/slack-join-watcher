# Bot User OAuth Token (xoxb-...) — used for chat.postMessage with custom username/icon.
SLACK_BOT_TOKEN=xoxb-your-bot-token

# App-Level Token (xapp-...) with `connections:write` scope — required for Socket Mode.
SLACK_APP_TOKEN=xapp-your-app-token

# User OAuth Token (xoxp-...) — required so the app can see channels the bot
# itself is not a member of. Issued when you "Install to Workspace" with user
# scopes set in the manifest.
SLACK_USER_TOKEN=xoxp-your-user-token

# Optional: path to the config file (defaults to ./config.json)
CONFIG_PATH=./config.json
